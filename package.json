{
  "name": "backtrace",
  "displayName": "Backtrace",
  "description": "Tree-based navigation history for VSCode — backtrack your exploration trail",
  "version": "0.3.0",
  "publisher": "jaredshaw",
  "repository": "https://github.com/JackShaw2333/backtrace-vscode-extension",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "backtrace.goBack",
        "title": "Backtrace: Go Back"
      },
      {
        "command": "backtrace.goForward",
        "title": "Backtrace: Go Forward"
      },
      {
        "command": "backtrace.deleteNode",
        "title": "Backtrace: Delete Node",
        "icon": "$(close)"
      },
      {
        "command": "backtrace.jumpToCaller",
        "title": "Backtrace: Jump to Caller",
        "icon": "$(arrow-left)"
      },
      {
        "command": "backtrace.moveNodeUp",
        "title": "Backtrace: Move Node Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "backtrace.moveNodeDown",
        "title": "Backtrace: Move Node Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "backtrace.createRoot",
        "title": "Backtrace: Create Root at Cursor",
        "icon": "$(home)"
      },
      {
        "command": "backtrace.renameRoot",
        "title": "Backtrace: Rename Root",
        "icon": "$(edit)"
      },
      {
        "command": "backtrace.promoteNodeToRoot",
        "title": "Backtrace: Promote to Root",
        "icon": "$(debug-start)"
      }
    ],
    "keybindings": [
      {
        "command": "backtrace.goBack",
        "key": "ctrl+alt+[",
        "mac": "ctrl+cmd+[",
        "when": "editorTextFocus"
      },
      {
        "command": "backtrace.goForward",
        "key": "ctrl+alt+]",
        "mac": "ctrl+cmd+]",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Backtrace",
      "properties": {
        "backtrace.maxTreeDepth": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Maximum depth of the navigation tree"
        },
        "backtrace.persistHistory": {
          "type": "boolean",
          "default": true,
          "description": "Persist navigation tree across VSCode sessions"
        },
        "backtrace.forwardBehavior": {
          "type": "string",
          "default": "notification",
          "enum": [
            "notification",
            "quickpick"
          ],
          "enumDescriptions": [
            "Show a status bar message when multiple forward options are available — use the Backtrace Stack sidebar to navigate",
            "Show a QuickPick list to choose from multiple forward options immediately"
          ],
          "description": "How to handle multiple forward navigation targets"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "backtraceStack",
          "name": "Backtrace Stack",
          "icon": "$(list-tree)"
        }
      ],
      "backtrace": [
        {
          "id": "backtraceTree",
          "name": "Backtrace Tree",
          "icon": "$(list-tree)"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "backtrace",
          "title": "Backtrace",
          "icon": "$(list-tree)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "backtraceStack",
        "when": "backtrace.isEmpty",
        "contents": "No navigation history yet.\nCreate a root with Backtrace: Create Root at Cursor to anchor an exploration thread, or navigate with F12/Ctrl+Click to start from the implicit root."
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "backtrace.createRoot",
          "when": "editorTextFocus",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "backtrace.renameRoot",
          "when": "view == backtraceTree && viewItem == 'root'",
          "group": "inline@1"
        },
        {
          "command": "backtrace.promoteNodeToRoot",
          "when": "view == backtraceTree && viewItem != 'root'",
          "group": "backtrace@1"
        },
        {
          "command": "backtrace.moveNodeUp",
          "when": "view == backtraceTree && viewItem != 'root'",
          "group": "inline@1"
        },
        {
          "command": "backtrace.moveNodeDown",
          "when": "view == backtraceTree && viewItem != 'root'",
          "group": "inline@2"
        },
        {
          "command": "backtrace.jumpToCaller",
          "when": "view == backtraceTree && viewItem != 'root'",
          "group": "inline@3"
        },
        {
          "command": "backtrace.deleteNode",
          "when": "view == backtraceTree",
          "group": "inline@4"
        },
        {
          "command": "backtrace.jumpToCaller",
          "when": "view == backtraceStack && viewItem != 'root'",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vscode-test"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.82.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "mocha": "^10.2.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
